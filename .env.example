# =============================================================================
# Waypoint Lodestar — Environment Variables
# Copy to .env and fill in your values.
# The DATABASE_URL is the only required external dependency.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Prisma — you provide this connection string)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/lodestar?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-also-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Internal service URLs (Docker network — do not change for compose)
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth:3001
ORDERS_SERVICE_URL=http://orders:3002
PLANNING_SERVICE_URL=http://planning:3003
FLEET_SERVICE_URL=http://fleet:3004
OUTLETS_SERVICE_URL=http://outlets:3005
TRIPS_SERVICE_URL=http://trips:3006
SYNC_SERVICE_URL=http://sync:3007
NOTIFICATIONS_SERVICE_URL=http://notifications:3008

# ---------------------------------------------------------------------------
# Frontend (Next.js) — publicly accessible
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ---------------------------------------------------------------------------
# SMS (optional — leave blank to disable, notifications fall back to WebSocket)
# ---------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=

# ---------------------------------------------------------------------------
# Seeding (set to "true" to run seed on container start)
# ---------------------------------------------------------------------------
RUN_SEED=true
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=lodestar2026
