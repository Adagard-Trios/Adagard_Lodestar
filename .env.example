# =============================================================================
# Waypoint Lodestar: local environment for `docker compose up`.
# Copy to .env. Every value has a dev-only default in docker-compose.yml, so .env is optional
# on a laptop. Set real, random values for any shared machine. On Azure, secrets come from
# Key Vault and identity from Entra ID (infra/terraform), not from this file.
# =============================================================================

# ---- Postgres (business data; Keycloak gets its own database and role)
POSTGRES_PASSWORD=lodestar-dev-only
KEYCLOAK_DB_PASSWORD=keycloak-dev-only

# ---- Public origin: the one URL people open (gateway, or the reverse proxy in front of it). It drives the
# Keycloak hostname and issuer (<origin>/auth/realms/lodestar) that every service validates, and the realm's
# redirect URIs and web origins (backend/identity/lodestar-realm.json placeholders, applied on realm import).
# The desk website (/) and the field app (/field/) derive their API, WebSocket and sign-in URLs from the page.
PUBLIC_ORIGIN=https://localhost:8443

# ---- Keycloak (OIDC identity provider for local runs)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
# Demo persona passwords (Fathima, Nilanthi, Kasun, Ruwan use the first; the admin uses the second)
LODESTAR_DEMO_PASSWORD=lodestar-dev-only
LODESTAR_ADMIN_PASSWORD=lodestar-admin-dev-only

# ---- Service identities: one confidential client per service (client-credentials grant).
# Keycloak imports these into the realm; each service uses its own to call the others.
SVC_AUTH_SECRET=svc-auth-dev-only
SVC_ORDERS_SECRET=svc-orders-dev-only
SVC_PLANNING_SECRET=svc-planning-dev-only
SVC_FLEET_SECRET=svc-fleet-dev-only
SVC_OUTLETS_SECRET=svc-outlets-dev-only
SVC_TRIPS_SECRET=svc-trips-dev-only
SVC_SYNC_SECRET=svc-sync-dev-only
SVC_NOTIFICATIONS_SECRET=svc-notifications-dev-only
SVC_AUDIT_SECRET=svc-audit-dev-only
SVC_AGENT_SECRET=svc-agent-dev-only

# ---- Field app (lodestar-field tokens), read by every NestJS service
# X-Device-Id must equal the token's device_id claim (401 DeviceMismatch); with the flag on (default)
# a field call without the header is refused too (401 DeviceHeaderRequired). Set false only for old builds.
# REQUIRE_DEVICE_HEADER=true
# Idempotency-Key records are kept this many hours (minimum and default 24).
# IDEMPOTENCY_TTL_HOURS=24

# ---- Planning agent model. "gemini": an LLM router, Google Gemini first, Groq second, the deterministic template
# last. The LLM classifies the dispatcher's request, picks enum planning preferences, chooses the "Ask the agent"
# tools and phrases verified text; trips, rule checks, simulation, deferrals and approval stay deterministic, and
# every edit it proposes is re-checked against the hard rules. Quota / rate-limit / timeout errors fall to the next
# provider; if both fail the run is marked LLM_DEGRADED and the template text is shown. With no key set it behaves
# like "mock" (the deterministic built-in model). "azure-openai" (optional) phrases text only.
AGENT_MODEL=gemini
# Free-tier keys: https://aistudio.google.com/apikey and https://console.groq.com/keys. Never commit real keys.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=20
# GEMINI_MAX_OUTPUT_TOKENS=512
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TIMEOUT_SECONDS=20
# GROQ_MAX_OUTPUT_TOKENS=512
# LLM_PRIMARY_PROVIDER=gemini
# LLM_FALLBACK_PROVIDER=groq
# LLM_MAX_RETRIES=1
# LLM_ENABLE_FALLBACK=true
# LLM_TEMPERATURE=0
# LLM_ENABLE_CACHE=true
# LLM_LOG_PROMPTS=false
# LLM_LOG_RESPONSES=false
# AGENT_MAX_REPAIR_ATTEMPTS=2
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_TIMEOUT_S=20

# ---- ML models (README "Departures"): the Adagard datathon models, served by the ml service from a host directory
# (never in the repo or the image). ML_MODELS_DIR holds task1_model.pkl + task2a_model.pkl, ML_DTCORE is dtcore.py.
# Missing files: the ml service says "degraded" and agent / trips / planning keep their heuristics.
# ML_URL= (empty) switches the models off for every caller; ML_TIMEOUT_MS (Node) / ML_TIMEOUT_S (agent) cap a call.
ML_MODELS_DIR=./datathon/Adagard_Datathon/models
ML_DTCORE=./datathon/Adagard_Datathon/dtcore.py
ML_URL=http://ml:8000

# ---- Seed: reference data loads from ./data/*.csv (gitignored, see backend/prisma/DATA.md);
# without those files a small synthetic demo dataset is created.
SKIP_SEED=false

# ---- Redis (Socket.IO adapter for notifications)
REDIS_PASSWORD=redis-dev-only

# ---- Orders: 4:00 PM cut-off (Asia/Colombo) the day before the run
# Stores are held to it; dispatch logs late phone orders with lateReason. An order saved on a phone
# before the cut-off still counts if it syncs within the grace window.
ENFORCE_ORDER_CUTOFF=true
ORDER_OFFLINE_GRACE_HOURS=6

# Demo clock: the run date the seed fills with the over-capacity demo day (YYYY-MM-DD). Empty = today in Sri Lanka.
DEMO_DATE=

# ---- SMS (notifications service; README "Departures"). In-app WebSocket notifications always go out.
# SMS_ENABLED=false: nothing is sent and the settings screens show SMS as "Not available in this deployment".
# SMS_ENABLED=true: SMS for the alerts each user turned on (DSP-20 / DSP-33 vehicle fault, SM-30 store topics),
# to their directory phone number. SMS_PROVIDER=log records what would be sent (notification payload.delivery.sms
# and the audit log); SMS_PROVIDER=http POSTs JSON {to, from, body} to SMS_API_URL with "Authorization: Bearer
# SMS_API_KEY". There is no phone-call channel (no voice provider).
SMS_ENABLED=false
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
