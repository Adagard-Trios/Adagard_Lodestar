# syntax=docker/dockerfile:1.7
# =============================================================================
# Waypoint Lodestar — migrate + seed job (runs once, then exits)
#   1. prisma migrate deploy   (all migrations: per-service schemas, "agent" schema)
#   2. seed                    (reference data from DATA_DIR CSVs when present,
#                               otherwise a small synthetic dataset; then our
#                               scenario; idempotent — safe to re-run)
# Mount the competition CSVs read-only at /data (never baked into the image).
# Set SKIP_SEED=true to only migrate.
# Runs as uid 1000 with a read-only root filesystem: HOME and every cache point
# at /tmp (mount an emptyDir/tmpfs there). Needs sh, prisma and ts-node.
# =============================================================================
FROM node:22-alpine
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --fetch-retries=10 --fetch-retry-maxtimeout=600000 --fetch-timeout=600000 --no-audit --no-fund
COPY tsconfig.json ./
COPY prisma ./prisma
RUN npx prisma generate
ENV NODE_ENV=production \
    DATA_DIR=/data \
    HOME=/tmp \
    npm_config_cache=/tmp/.npm \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    CHECKPOINT_DISABLE=1 \
    PATH=/app/node_modules/.bin:$PATH
USER 1000:1000
HEALTHCHECK NONE
CMD ["sh", "-c", "prisma migrate deploy && if [ \"$SKIP_SEED\" = 'true' ]; then echo 'Seed skipped'; else ts-node --transpile-only prisma/seed.ts; fi"]
