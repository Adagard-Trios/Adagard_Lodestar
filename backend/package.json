{
  "name": "lodestar-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Waypoint Lodestar backend: NestJS OData v4 microservices with zero-trust security",
  "scripts": {
    "build": "node tools/build-all.js",
    "build:app": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:auth": "node dist/apps/auth/main",
    "start:orders": "node dist/apps/orders/main",
    "start:planning": "node dist/apps/planning/main",
    "start:fleet": "node dist/apps/fleet/main",
    "start:outlets": "node dist/apps/outlets/main",
    "start:trips": "node dist/apps/trips/main",
    "start:sync": "node dist/apps/sync/main",
    "start:notifications": "node dist/apps/notifications/main",
    "start:audit": "node dist/apps/audit/main",
    "dev:auth": "nest start auth --watch",
    "dev:orders": "nest start orders --watch",
    "dev:planning": "nest start planning --watch",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint \"{apps,libs,prisma,tools}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs,prisma,tools}/**/*.ts\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "gen:gateway": "ts-node -r tsconfig-paths/register --transpile-only tools/gateway-odata.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-mockito": "^2.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.3"
  }
}
