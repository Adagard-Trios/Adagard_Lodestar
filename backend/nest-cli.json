{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth/src",
  "monorepo": true,
  "root": "apps/auth",
  "compilerOptions": {
    "tsConfigPath": "apps/auth/tsconfig.app.json"
  },
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "orders": {
      "type": "application",
      "root": "apps/orders",
      "entryFile": "main",
      "sourceRoot": "apps/orders/src",
      "compilerOptions": {
        "tsConfigPath": "apps/orders/tsconfig.app.json"
      }
    },
    "planning": {
      "type": "application",
      "root": "apps/planning",
      "entryFile": "main",
      "sourceRoot": "apps/planning/src",
      "compilerOptions": {
        "tsConfigPath": "apps/planning/tsconfig.app.json"
      }
    },
    "fleet": {
      "type": "application",
      "root": "apps/fleet",
      "entryFile": "main",
      "sourceRoot": "apps/fleet/src",
      "compilerOptions": {
        "tsConfigPath": "apps/fleet/tsconfig.app.json"
      }
    },
    "outlets": {
      "type": "application",
      "root": "apps/outlets",
      "entryFile": "main",
      "sourceRoot": "apps/outlets/src",
      "compilerOptions": {
        "tsConfigPath": "apps/outlets/tsconfig.app.json"
      }
    },
    "trips": {
      "type": "application",
      "root": "apps/trips",
      "entryFile": "main",
      "sourceRoot": "apps/trips/src",
      "compilerOptions": {
        "tsConfigPath": "apps/trips/tsconfig.app.json"
      }
    },
    "sync": {
      "type": "application",
      "root": "apps/sync",
      "entryFile": "main",
      "sourceRoot": "apps/sync/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sync/tsconfig.app.json"
      }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications/tsconfig.app.json"
      }
    },
    "prisma-lib": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    }
  }
}
